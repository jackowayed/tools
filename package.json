{
  "name": "personal-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "dev": "wrangler dev --persist-to ../.tools-sync-state",
    "check": "node --check sync-client.js && node --check sync-protocol.js && node --check worker/sync.js && node --check worker/index.js",
    "test:browser:install": "playwright-core install --with-deps chromium",
    "test:browser": "node --test tests/sync.browser.js",
    "db:local": "wrangler d1 migrations apply tools-baby-weight-sync --local --persist-to ../.tools-sync-state"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "miniflare": "^4.20260730.0",
    "playwright-core": "^1.64.0",
    "wrangler": "^4.149.0"
  }
}
